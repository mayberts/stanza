{
	"name": "stanza",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Scans a music library and fetches the matching .lrc lyrics file (synced, or plain as a fallback) for each track, from LRCLIB.",
	"bin": {
		"stanza": "./dist/index.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"dev": "tsx src/index.ts",
		"start": "node dist/index.js",
		"check": "tsc --noEmit",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"dependencies": {
		"better-sqlite3": "^13.0.2",
		"chokidar": "^4.0.3",
		"commander": "^14.0.1",
		"dotenv": "^17.2.3",
		"music-metadata": "^11.9.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/better-sqlite3": "^7.6.13",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"tsx": "^4.20.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1"
	}
}
