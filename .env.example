# Port the dashboard listens on (read by SvelteKit's adapter-node, not by
# Stanza's own config — only relevant to `node build` / Docker).
PORT=3000

# Directory to scan, recursively. Mount your music library here in Docker.
MUSIC_DIR=/music

# Where the SQLite state DB lives (tracks what's already been checked/matched).
DB_PATH=/config/stanza.db

# Full rescan cadence, in minutes. Watch mode still reacts to filesystem
# events immediately — this is a safety net for events a watcher can miss
# (e.g. network shares) and for retrying not-found tracks.
SCAN_INTERVAL_MINUTES=60

# How long to wait before retrying a track LRCLIB had no match for, in hours.
RETRY_NOT_FOUND_AFTER_HOURS=24

# Use polling instead of native filesystem events in watch mode. Turn this on
# if MUSIC_DIR is a network share (NFS/SMB) where inotify events don't fire.
USE_POLLING=false
POLL_INTERVAL_MS=15000

# Minimum delay between LRCLIB requests, in milliseconds — be a good API citizen.
RATE_LIMIT_MS=1000

# Overwrite .lrc files that already exist on disk but weren't written by
# Stanza itself. Leave false to never touch lyrics you (or another tool)
# already placed there.
OVERWRITE_EXISTING=false

LRCLIB_BASE_URL=https://lrclib.net/api

# error | warn | info | debug
LOG_LEVEL=info
